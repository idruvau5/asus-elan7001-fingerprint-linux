+static void
+elanspi_press_capture_and_submit (FpiDeviceElanSpi *self)
+{
+  guint8 saved_frame_width = self->frame_width;
+  guint8 saved_frame_height = self->frame_height;
+  guint8 press_width;
+  guint8 press_height;
+
+  /* The legacy swipe path limits frames to 43 rows. ELAN eFSA96SA is a
+   * 96x96 touch sensor; Windows captures the complete press frame. Use the
+   * full native dimensions here so SIGFM sees enough stable keypoints. */
+  if (fpi_device_get_driver_data (FP_DEVICE (self)) & ELANSPI_HV_FLIPPED)
+    {
+      press_width = self->sensor_height;
+      press_height = self->sensor_width;
+    }
+  else
+    {
+      press_width = self->sensor_width;
+      press_height = self->sensor_height;
+    }
+
+  self->frame_width = press_width;
+  self->frame_height = press_height;
+  g_autoptr(FpImage) img = fp_image_new (press_width, press_height);
+
+  /* Windows switches this ELAN7001 sensor to FPSensorMode=2 and captures
+   * one complete frame after SensorWaitFingerPress. Reproduce that
+   * press-oriented flow instead of assembling a swipe. */
+  elanspi_correct_with_bg (self, self->last_image);
+  elanspi_process_frame (self, self->last_image, img->data);
+  img->flags |= FPI_IMAGE_COLORS_INVERTED;
+  elanspi_smooth_image (img);
+
+  self->frame_width = saved_frame_width;
+  self->frame_height = saved_frame_height;
+
+  fpi_image_device_image_captured (FP_IMAGE_DEVICE (self),
+                                   g_steal_pointer (&img));
+  /* This is a touch/press sensor. The Windows driver stops acquisition after
+   * the single press frame; continuing to poll full frames while the matcher
+   * runs keeps the LED/array powered and can trigger the ELAN thermal guard. */
+  fpi_image_device_report_finger_status (FP_IMAGE_DEVICE (self), FALSE);
+}
